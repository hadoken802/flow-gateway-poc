GATEWAY_API_HOST=127.0.0.1
GATEWAY_API_PORT=8200
GATEWAY_DB_PATH=%FLOWKIT_HOME%\data\embedded_gateway.db
FLOWKIT_GATEWAY_WORKER_SOURCE=static_json
GATEWAY_WORKERS_PATH=%FLOWKIT_HOME%\runtime\embedded_workers.json
FLOW_GATEWAY_OUTPUT_DIR=%FLOWKIT_HOME%\outputs
